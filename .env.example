# Supabase Configuration
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Telegram Admin configuration
VITE_ADMIN_ID=PLACEHOLDER_ADMIN_ID
